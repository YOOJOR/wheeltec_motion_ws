FROM docker.io/library/ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release && \
    curl -fsSL https://packages.osrfoundation.org/gazebo.gpg -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] https://packages.osrfoundation.org/gazebo/ubuntu-stable jammy main' > /etc/apt/sources.list.d/gazebo-stable.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config python3-dev python3-pip python3-colcon-common-extensions \
    python3-rosdep python3-numpy python3-scipy python3-opencv python3-yaml \
    ignition-fortress libignition-gazebo6-dev libignition-plugin-dev \
    ros-humble-ros-gz-bridge ros-humble-rviz2 ros-humble-robot-state-publisher \
    ros-humble-tf-transformations ros-humble-message-filters ros-humble-cv-bridge \
    ros-humble-tf2-ros ros-humble-nav-msgs ros-humble-sensor-msgs ros-humble-rosgraph-msgs \
    libgl1 libegl1 libgl1-mesa-dri libglib2.0-0 libgomp1 && \
    rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/conavbot-sim-requirements.txt
ARG PIP_FIND_LINKS
RUN python3 -m pip install --no-cache-dir torch==2.2.2 torchvision==0.17.2 --index-url https://download.pytorch.org/whl/cpu
RUN python3 -m pip install --no-cache-dir -r /tmp/conavbot-sim-requirements.txt
ENV QT_X11_NO_MITSHM=1
WORKDIR /workspace/wheeltec_motion_ws
