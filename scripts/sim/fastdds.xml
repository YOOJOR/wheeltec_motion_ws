<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>sim_shm</transport_id>
      <type>SHM</type>
      <!-- RGB + float depth exceed the default 512 KiB segment. -->
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>sim_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="conavbot_sim" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>sim_shm</transport_id>
        <transport_id>sim_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
