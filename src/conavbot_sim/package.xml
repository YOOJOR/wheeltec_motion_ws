<?xml version="1.0"?>
<package format="3">
  <name>conavbot_sim</name><version>0.1.0</version>
  <description>Interactive physical simulation for CoNavBot.</description>
  <maintainer email="maintainer@example.com">CoNavBot maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend><depend>geometry_msgs</depend><depend>nav_msgs</depend>
  <depend>sensor_msgs</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <depend>rosgraph_msgs</depend><depend>tf2_ros</depend><depend>visualization_msgs</depend>
  <depend>wheeltec_motion_interfaces</depend>
  <exec_depend>wheeltec_motion_control</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend><exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
