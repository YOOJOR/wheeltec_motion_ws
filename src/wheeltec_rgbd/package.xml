<?xml version="1.0"?>
<package format="3">
  <name>wheeltec_rgbd</name><version>0.1.0</version>
  <description>Camera-only acquisition, validation and fresh RGB-D observations.</description>
  <maintainer email="maintainer@example.com">WHEELTEC project maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>wheeltec_rgbd_interfaces</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
